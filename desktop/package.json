{
  "name": "unihelperpromax-desktop",
  "productName": "UniHelperProMax",
  "desktopName": "unihelperpromax.desktop",
  "version": "1.0.3",
  "description": "Your whole semester in one calm place.",
  "license": "AGPL-3.0-only",
  "author": "Nima Jelodari",
  "homepage": "https://github.com/Nimaj2002/UniHelperProMax",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc -p . && node scripts/copy-static.cjs",
    "probe": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "build:e2e": "npm run build && electron-builder --dir -c.electronFuses.enableNodeCliInspectArguments=true -c.directories.output=release-e2e",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "koffi": "3.3.2"
  }
}
